# Google Maps (Android) — usado pelo react-native-maps via app.config.js.
# Sem a key o build funciona, mas o mapa renderiza em branco.
# O Gradle lê esta variável em tempo de build (manifestPlaceholders); trocar a key
# exige rebuild do app Android para ter efeito.
GOOGLE_MAPS_ANDROID_API_KEY=

# Pagamentos (F8). "mock" mantém o app como antes; "stripe" usa as Edge
# Functions de pagamento e exige a publishable key (pk_test_... no piloto).
EXPO_PUBLIC_PAYMENTS_PROVIDER=mock
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secrets das Edge Functions de pagamento. NÃO preencher aqui: só em
# Supabase > Edge Functions > Secrets (a secret key nunca entra no app).
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   STRIPE_CONNECT_WEBHOOK_SECRET
#   PLATFORM_FEE_BPS
#   FURA_FILA_MAX_CENTS
#   CONNECT_RETURN_BASE_URL
#   DEMO_FURA_FILA_BUSINESS_ID
