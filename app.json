{
  "expo": {
    "name": "wall-to-all",
    "slug": "wall-to-all",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kavicki.walltoall",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Este app precisa acessar sua galeria de fotos para adicionar o logotipo do seu negócio.",
        "NSCameraUsageDescription": "Este app precisa acessar sua câmera para tirar uma foto do logotipo do seu negócio."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "backgroundColor": "#FAFAFA"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.walltoall"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para adicionar o logotipo do negócio.",
          "cameraPermission": "O app precisa acessar sua câmera para tirar uma foto do logotipo do negócio."
        }
      ],
      "expo-asset"
    ],
    "scheme": "walltoall",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbc84d0e-1278-4eb0-869e-af6ebb163552"
      },
      "supabaseUrl": "https://SEU-PROJETO.supabase.co",
      "supabaseAnonKey": "SEU_SUPABASE_ANON_KEY"
    }
  }
}
