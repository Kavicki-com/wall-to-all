{
  "expo": {
    "name": "wall-to-all",
    "slug": "wall-to-all",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kavicki.walltoall",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Este app precisa acessar sua galeria de fotos para adicionar o logotipo do seu negócio.",
        "NSCameraUsageDescription": "Este app precisa acessar sua câmera para tirar uma foto do logotipo do seu negócio."
      },
      "privacyUrl": "https://walltoall.com.br/privacy"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "backgroundColor": "#FAFAFA"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "package": "com.kavicki.walltoall",
      "versionCode": 14,
      "config": {
        "googleMaps": {
          "apiKey": "PLACEHOLDER_REPLACE_ME"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para adicionar o logotipo do negócio.",
          "cameraPermission": "O app precisa acessar sua câmera para tirar uma foto do logotipo do negócio."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#000E3D"
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "O app precisa da câmera para gravar vídeos e stories do seu negócio.",
          "microphonePermission": "O app precisa do microfone para gravar o áudio dos vídeos."
        }
      ]
    ],
    "scheme": "walltoall",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbc84d0e-1278-4eb0-869e-af6ebb163552"
      }
    }
  }
}
